# Copy to .env and fill in. Never commit .env.

# LLM — get a free key at https://aistudio.google.com (API keys page)
GOOGLE_API_KEY=
# Using an AI Studio key (not Vertex ADC); ADK reads this flag.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model. Flash versions ship roughly monthly and retire on a schedule, so the
# model is pinned here and every bump is treated like a config change: run
# `python -m evals.run_evals` before and after, compare scorecards.
TRIAGE_AGENT_MODEL=gemini-3.8-flash

# Mock helpdesk / CRM API (defaults work out of the box)
HELPDESK_BASE_URL=http://127.0.0.1:8086
HELPDESK_CLIENT_ID=demo-client
HELPDESK_CLIENT_SECRET=demo-secret

# Safety controls (see triage_agent/guard.py)
# AGENT_HALT=1 stops every write before it reaches the API; a file named HALT in
# the repo root does the same. MAX_CREDIT_USD caps what issue_credit may ever do,
# even with human approval.
AGENT_HALT=0
HALT_FILE_PATH=HALT
MAX_CREDIT_USD=150
# A previewed payload must be confirmed within this window or it is re-previewed.
PREVIEW_TTL_SECONDS=900
AUDIT_LOG_PATH=audit/audit.jsonl
